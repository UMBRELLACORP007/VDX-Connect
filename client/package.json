{
  "name": "vdx-connect",
  "private": true,
  "version": "1.1.1",
  "description": "VDX Connect \u2014 private device-to-device remote control, file transfer, and chat.",
  "author": "UMBRELLACORP007",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "lint": "oxlint",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win",
    "publish:win": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@nut-tree-fork/nut-js": "^4.2.0",
    "electron-updater": "^6.3.9",
    "framer-motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.umbrellacorp007.vdxconnect",
    "productName": "VDX Connect",
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/config/device-config.js",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@nut-tree-fork/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "UMBRELLACORP007",
      "repo": "VDX-Releases",
      "private": true,
      "releaseType": "release"
    }
  }
}